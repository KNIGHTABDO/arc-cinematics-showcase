# Serverless Configuration

# 1. Supabase (Database & Auth)
# Get from: https://supabase.com/dashboard/project/.../settings/api
# Used by auth, profiles, watch history, and stream resolver telemetry persistence
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. TMDB (Metadata & Images)
# Get from: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your-tmdb-api-v3-key

# 3. SubDL (Subtitles)
# Get from: https://subdl.com/api
# Used by server subtitle resolver for both movie + TV (season/episode-aware) search and SRT->VTT conversion
VITE_SUBDL_API_KEY=your-s...-key

# 4. Real-Debrid (Streaming Backbone)
# Get from: https://real-debrid.com/apitoken
# Note: used server-side for torrent resolve + stream preflight validation
# Resolver now tries multiple RD links for selected files, validates each via preflight,
# returns backup unrestricted URLs for runtime player failover,
# and prefers browser-friendly AVC/x264 streams when ranking candidates.
#
# Optional iOS quality hardening (safe rollout: keep disabled initially)
# When enabled, iOS candidate/file selection rejects obvious low-quality sources
# (cam/hdcam/ts/hdts/telesync/workprint) and enforces minimum filesize floors
# for advertised 1080p/720p labels before returning a stream.
VITE_REAL_DEBRID_TOKEN=***
VITE_IOS_QUALITY_HARDENING_ENABLED=false
VITE_IOS_QUALITY_HARDENING_REJECT_TRASH=true
VITE_IOS_QUALITY_MIN_BYTES_1080=1500000000
VITE_IOS_QUALITY_MIN_BYTES_720=800000000

# 5. Kids/Profile hardening
# No additional environment variables required.
# Restrictions and profile-scoping are enforced in app/server logic.
